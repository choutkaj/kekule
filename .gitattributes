# Provenance-pinned external fixtures must retain byte-exact source checksums.
crates/kekule-openff/data/** -text
crates/kekule/tests/fixtures/corpus/*/data/** binary
crates/kekule/tests/fixtures/corpus/rdkit-structures/upstream/** binary
# Seed provenance locks retain their original bytes, including CRLF.
fuzz/provenance/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/openff/upstream/** -text
tools/openff/models.lock.json -text
# Benchmark inputs and the notices packed beside them keep their exact bytes.
benchmarks/datasets/*/curated/** binary
benchmarks/datasets/*/LICENSE* -text
crates/kekule-traj/tests/fixtures/*.xyz binary
crates/kekule/tests/fixtures/cip/*.sdf binary
crates/kekule/tests/fixtures/perception/*.sdf binary
crates/kekule/src/structure/solvation/data/*.bin binary
crates/kekule-openff-ash/data/** binary
