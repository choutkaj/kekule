  "probe_source": "use std::{hint::black_box, time::Instant};\nuse kekule_openff::{ForceField, NaglModel};\nuse serde_json::{json, Value};\nfn measure(mut f: impl FnMut(), count: usize) -> Vec<f64> {\n    f();\n    (0..count).map(|_| { let t=Instant::now(); f(); t.elapsed().as_secs_f64()*1000.0 }).collect()\n}\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    let t=Instant::now();\n    let model=NaglModel::load(\"target/openff-ash\")?;\n    let model_load_ms=t.elapsed().as_secs_f64()*1000.0;\n    let ff=ForceField::rosemary()?;\n    println!(\"{}\",json!({\"model_load_ms\":model_load_ms}));\n    let records: Vec<Value>=serde_json::from_slice(&std::fs::read(\"target/openff-timing-probe/inputs.json\")?)?;\n    for record in records {\n        let m=kekule::smiles::to_molecules(record[\"smiles\"].as_str().unwrap())?.remove(0);\n        let features=measure(|| {black_box(model.atom_features(&m).unwrap());},5);\n        let infer=measure(|| {black_box(model.infer_charges(&m).unwrap());},5);\n        let assign=measure(|| {black_box(model.assign_charges(&m).unwrap());},5);\n        let full=measure(|| {black_box(ff.parameterize_molecule(&m,&model).unwrap());},3);\n        println!(\"{}\",json!({\"id\":record[\"id\"],\"atoms\":m.atom_count(),\"features_ms\":features,\"inference_including_features_ms\":infer,\"assign_charges_ms\":assign,\"full_parameterization_ms\":full}));\n    }\n    Ok(())\n}\n",
