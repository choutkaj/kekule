C(=O)Cl	AcidChloride
[$(C-!@[a])](=O)(Cl)	AcidChloride.Aromatic
[$(C-!@[A;!Cl])](=O)(Cl)	AcidChloride.Aliphatic
C(=O)[O;H,-]	CarboxylicAcid
[$(C-!@[a])](=O)([O;H,-])	CarboxylicAcid.Aromatic
[$(C-!@[A;!O])](=O)([O;H,-])	CarboxylicAcid.Aliphatic
[$(C-[C;!$(C=[!#6])]-[N;!H0;!$(N-[!#6;!#1]);!$(N-C=[O,N,S])])](=O)([O;H,-])	CarboxylicAcid.AlphaAmino
[$(S-!@[#6])](=O)(=O)(Cl)	SulfonylChloride
[$(S-!@c)](=O)(=O)(Cl)	SulfonylChloride.Aromatic
[$(S-!@C)](=O)(=O)(Cl)	SulfonylChloride.Aliphatic
[N;$(N-[#6]);!$(N-[!#6;!#1]);!$(N-C=[O,N,S])]	Amine
[N;H2;D1;$(N-!@[#6]);!$(N-C=[O,N,S])]	Amine.Primary
[N;H2;D1;$(N-!@c);!$(N-C=[O,N,S])]	Amine.Primary.Aromatic
[N;H2;D1;$(N-!@C);!$(N-C=[O,N,S])]	Amine.Primary.Aliphatic
[N;H1;D2;$(N(-[#6])-[#6]);!$(N-C=[O,N,S])]	Amine.Secondary
[N;H1;D2;$(N(-[c])-[#6]);!$(N-C=[O,N,S])]	Amine.Secondary.Aromatic
[N;H1;D2;$(N(-C)-C);!$(N-C=[O,N,S])]	Amine.Secondary.Aliphatic
[N;H0;D3;$(N(-[#6])(-[#6])-[#6]);!$(N-C=[O,N,S])]	Amine.Tertiary
[N;H0;D3;$(N(-[c])(-[#6])-[#6]);!$(N-C=[O,N,S])]	Amine.Tertiary.Aromatic
[N;H0;D3;$(N(-C)(-C)-C);!$(N-C=[O,N,S])]	Amine.Tertiary.Aliphatic
[N;$(N-c);!$(N-[!#6;!#1]);!$(N-C=[O,N,S])]	Amine.Aromatic
[N;!$(N-c);$(N-C);!$(N-[!#6;!#1]);!$(N-C=[O,N,S])]	Amine.Aliphatic
[N;R;$(N-[#6]);!$(N-[!#6;!#1]);!$(N-C=[O,N,S])]	Amine.Cyclic
[$(B-!@[#6])](O)(O)	BoronicAcid
[$(B-!@c)](O)(O)	BoronicAcid.Aromatic
[$(B-!@C)](O)(O)	BoronicAcid.Aliphatic
[$(N-!@[#6])](=!@C=!@O)	Isocyanate
[$(N-!@c)](=!@C=!@O)	Isocyanate.Aromatic
[$(N-!@C)](=!@C=!@O)	Isocyanate.Aliphatic
[O;H1;$(O-!@[#6;!$(C=!@[O,N,S])])]	Alcohol
[O;H1;$(O-!@c)]	Alcohol.Aromatic
[O;H1;$(O-!@[C;!$(C=!@[O,N,S])])]	Alcohol.Aliphatic
[CH;D2;!$(C-[!#6;!#1])]=O	Aldehyde
[CH;D2;$(C-!@[a])](=O)	Aldehyde.Aromatic
[CH;D2;$(C-!@C)](=O)	Aldehyde.Aliphatic
[$([F,Cl,Br,I]-!@[#6]);!$([F,Cl,Br,I]-!@C-!@[F,Cl,Br,I]);!$([F,Cl,Br,I]-[C,S](=[O,S,N]))]	Halogen
[F,Cl,Br,I;$(*-!@c)]	Halogen.Aromatic
[$([F,Cl,Br,I]-!@C);!$([F,Cl,Br,I]-!@C-!@[F,Cl,Br,I])]	Halogen.Aliphatic
[$([Cl,Br,I]-!@[#6]);!$([Cl,Br,I]-!@C-!@[F,Cl,Br,I]);!$([Cl,Br,I]-[C,S](=[O,S,N]))]	Halogen.NotFluorine
[$([Cl,Br,I]-!@C);!$([Cl,Br,I]-!@C-!@[F,Cl,Br,I]);!$([Cl,Br,I]-[C,S](=[O,S,N]))]	Halogen.NotFluorine.Aliphatic
[$([Cl,Br,I]-!@c)]	Halogen.NotFluorine.Aromatic
[Br;$([Br]-!@[#6]);!$([Br]-!@C-!@[F,Cl,Br,I]);!$([Br]-[C,S](=[O,S,N]))]	Halogen.Bromine
[Br;$(Br-!@C);!$(Br-!@C-!@[F,Cl,Br,I]);!$(Br-[C,S](=[O,S,N]))]	Halogen.Bromine.Aliphatic
[Br;$(Br-!@c)]	Halogen.Bromine.Aromatic
[Br;$(Br-[CH2]-C(=O)-[#6])]	Halogen.Bromine.BromoKetone
[N;H0;$(N-[#6]);D2]=[N;D2]=[N;D1]	Azide
[N;H0;$(N-c);D2]=[N;D2]=[N;D1]	Azide.Aromatic
[N;H0;$(N-C);D2]=[N;D2]=[N;D1]	Azide.Aliphatic
[N;H0;$(N-[#6]);D3](=[O;D1])~[O;D1]	Nitro
[N;H0;$(N-c);D3](=[O;D1])~[O;D1]	Nitro.Aromatic
[N;H0;$(N-C);D3](=[O;D1])~[O;D1]	Nitro.Aliphatic
[C;$(C#[CH])]	TerminalAlkyne
